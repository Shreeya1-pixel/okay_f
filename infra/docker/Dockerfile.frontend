# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY frontend/ .

# Bake API URL into the SPA at build time (Railway/Render inject service env as Docker build ARGs)
ARG VITE_API_URL=http://localhost:8000/api/v1
ENV VITE_API_URL=$VITE_API_URL

RUN pnpm build

# ── Stage 2: Serve ────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS production

RUN rm -rf /usr/share/nginx/html/*

COPY --from=builder /app/dist /usr/share/nginx/html
COPY infra/docker/nginx.frontend.conf /etc/nginx/templates/default.conf.template
COPY scripts/start_frontend.sh /start_frontend.sh
RUN chmod +x /start_frontend.sh

ENV PORT=80
EXPOSE 80

CMD ["/start_frontend.sh"]
