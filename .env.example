# GeoTrade Environment Configuration
# Copy this file to .env and fill in your API keys
# DO NOT commit .env files with real API keys to git

# ========================
# CORE APP CONFIG
# ========================
ENV=development
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# ========================
# DATABASE
# ========================
# Local Docker Compose defaults. On Render/Neon, paste their connection string —
# the app auto-converts postgres:// → postgresql+asyncpg:// and adds SSL.
DATABASE_URL=postgresql+asyncpg://geotrade:geotrade_secret@localhost:5432/geotrade
DATABASE_SYNC_URL=postgresql+psycopg2://geotrade:geotrade_secret@localhost:5432/geotrade

# ========================
# REDIS / CELERY
# ========================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ========================
# FRONTEND (CORS)
# ========================
# Comma-separated production frontend origins after Vercel deploy
FRONTEND_URL=

# ========================
# COINGECKO (CRYPTO - FREE, NO KEY REQUIRED)
# ========================
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# ========================
# ALPACA (STOCKS + ETFs)
# Get keys at: https://alpaca.markets/
# ========================
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# ========================
# TWELVE DATA (FOREX + COMMODITIES)
# Get key at: https://twelvedata.com/
# ========================
TWELVEDATA_API_KEY=

# ========================
# FRED (BONDS + ECONOMIC DATA)
# Get key at: https://fred.stlouisfed.org/docs/api/api_key.html
# ========================
FRED_API_KEY=

# ========================
# FINNHUB (STOCKS - ALTERNATIVE TO ALPACA)
# Get key at: https://finnhub.io/
# ========================
FINNHUB_API_KEY=
FINNHUB_API_KEY_2=

# ========================
# ALPHA VANTAGE (FOREX/COMMODITIES BACKUP)
# Get key at: https://www.alphavantage.co/support/#api-key
# ========================
ALPHAVANTAGE_API_KEY=

# ========================
# NEWS API (GEOPOLITICAL NEWS)
# Get key at: https://newsapi.org/
# ========================
NEWSAPI_KEY=

# ========================
# SUPABASE (DATABASE + AUTH / WAITLIST)
# ========================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ========================
# EXTERNAL AI/LLM (OPTIONAL)
# ========================
OPENROUTER_API_KEY=

# ========================
# BROKERAGE APIs (OPTIONAL - FOR LIVE TRADING)
# ========================
# OANDA Forex
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# CCXT Crypto Exchange
CCXT_EXCHANGE=binance
CCXT_API_KEY=
CCXT_SECRET=
CCXT_SANDBOX=true

# ========================
# TELEMETRY (OPTIONAL)
# ========================
ENABLE_OTEL=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=geotrade

# ========================
# WEBHOOKS (OPTIONAL - FOR ALERTS)
# ========================
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
